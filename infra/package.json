{
    "name": "infra",
    "version": "0.1.0",
    "scripts": {
        "build": "tsc",
        "build:frontend": "npm --prefix ../frontend run build",
        "synth": "npm run build && npm run build:frontend && cdk synth",
        "diff": "npm run build && npm run build:frontend && cdk diff",
        "deploy": "npm run build && npm run build:frontend && cdk deploy --require-approval never",
        "destroy": "npm run build && npm run build:frontend && cdk destroy --force",
        "watch": "tsc -w",
        "test": "jest",
        "cdk": "cdk"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.162",
        "@types/jest": "^30",
        "@types/node": "^24.10.1",
        "aws-cdk": "2.1130.0",
        "esbuild": "^0.28.1",
        "jest": "^30",
        "prettier": "^3.9.5",
        "ts-jest": "^29",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.1091.0",
        "@aws-sdk/lib-dynamodb": "^3.1091.0",
        "aws-cdk-lib": "^2.261.0",
        "constructs": "^10.5.0",
        "dotenv": "^17.4.2"
    }
}
