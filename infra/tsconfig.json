{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node", "jest"],
        "rootDir": ".",
        "outDir": "dist",
        "declaration": true,
        "inlineSourceMap": true,
        "inlineSources": true,
        "noEmitOnError": true,
        "strict": true,
        "noImplicitReturns": true,
        "experimentalDecorators": true,
        "strictPropertyInitialization": false,
        "skipLibCheck": true
    },
    "include": ["bin/**/*.ts", "lib/**/*.ts", "functions/**/*.ts", "test/**/*.ts"],
    "exclude": ["node_modules", "dist", "cdk.out"]
}
